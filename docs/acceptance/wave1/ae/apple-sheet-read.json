                "identifier": "doc://com.apple.appkit/documentation/AppKit/NSWindow/orderOut(_:)",
                "isActive": true,
                "type": "reference"
              },
              {
                "text": " method with the value ",
                "type": "text"
              },
              {
                "code": "nil",
                "type": "codeVoice"
              },
              {
                "text": ".",
                "type": "text"
              }
