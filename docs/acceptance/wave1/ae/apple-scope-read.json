      "title": "startAccessingSecurityScopedResource()"
    },
    "abstract": [
      {
        "text": "In an app that has adopted App Sandbox, makes the resource pointed to by a security-scoped URL available to the app.",
        "type": "text"
      }
    ],
    "primaryContentSections": [
