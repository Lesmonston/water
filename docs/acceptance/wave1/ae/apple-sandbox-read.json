      "role": "collectionGroup",
      "title": "App Sandbox"
    },
    "abstract": [
      {
        "text": "Restrict access to system resources and user data in macOS apps to contain damage if an app becomes compromised.",
        "type": "text"
      }
    ],
    "primaryContentSections": [
      {
        "content": [
          {
            "anchor": "Overview",
            "level": 2,
            "text": "Overview",
            "type": "heading"
          },
          {
            "inlineContent": [
              {
                "text": "App Sandbox provides protection to system resources and user data by limiting your app’s access to resources requested through entitlements.",
                "type": "text"
              }
            ],
            "type": "paragraph"
          },
          {
            "content": [
              {
                "inlineContent": [
                  {
                    "text": "",
                    "type": "text"
                  },
                  {
                    "text": " ",
                    "type": "text"
                  },
                  {
                    "text": "To distribute a macOS app through the Mac App Store, you must enable the App Sandbox capability.",
                    "type": "text"
                  }
                ],
                "type": "paragraph"
              }
            ],
            "name": "Important",
            "style": "important",
            "type": "aside"
          }
        ],
        "kind": "content"
      }
