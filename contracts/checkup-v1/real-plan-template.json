{
  "plan_version": "water.scan-plan.v1",
  "rules_data_version": "2026-10-26.0",
  "created_at": "{{created_at}}",
  "targets": [
    {"target_id": "codex-marketplace-staging#0", "group_id": "codex-marketplace-staging", "rule_id": "codex-marketplace-staging", "level": "recommended", "category": "agent_tool",
     "match": {"kind": "pattern", "base": "{{user_profile}}", "segments": [".codex*", ".tmp", "marketplaces", ".staging", "marketplace-upgrade-*"]},
     "item_type": "dir", "min_age_hours": 1, "keep_newest": 0, "in_use": {"mode": "none", "processes": []}},
    {"target_id": "claude-desktop-old-versions#0", "group_id": "claude-desktop-old-versions", "rule_id": "claude-desktop-old-versions", "level": "recommended", "category": "agent_tool",
     "match": {"kind": "pattern", "base": "{{local_app_data}}", "segments": ["AnthropicClaude", "app-*"]},
     "item_type": "dir", "min_age_hours": 24, "keep_newest": 1, "in_use": {"mode": "cmdline_references_item", "processes": ["claude.exe"]}},
    {"target_id": "claude-code-sessions#0", "group_id": "claude-code-sessions", "rule_id": "claude-code-sessions", "level": "protected", "category": "agent_tool",
     "match": {"kind": "pattern", "base": "{{user_profile}}", "segments": [".claude", "projects"]},
     "item_type": "dir", "min_age_hours": 0, "keep_newest": 0, "in_use": {"mode": "none", "processes": []}},
    {"target_id": "claude-code-scratchpad#0", "group_id": "claude-code-scratchpad", "rule_id": "claude-code-scratchpad", "level": "confirm", "category": "agent_tool",
     "match": {"kind": "pattern", "base": "{{system_temp}}", "segments": ["claude", "*", "*"]},
     "item_type": "dir", "min_age_hours": 72, "keep_newest": 0, "in_use": {"mode": "none", "processes": []}},
    {"target_id": "chrome-cache#0", "group_id": "chrome-cache", "rule_id": "chrome-cache", "level": "recommended", "category": "browser",
     "match": {"kind": "pattern", "base": "{{local_app_data}}", "segments": ["Google", "Chrome", "User Data", "*", "Cache"]},
     "item_type": "dir", "min_age_hours": 0, "keep_newest": 0, "in_use": {"mode": "process_running", "processes": ["chrome.exe"]}},
    {"target_id": "chrome-login-and-site-data#0", "group_id": "chrome-login-and-site-data", "rule_id": "chrome-login-and-site-data", "level": "protected", "category": "browser",
     "match": {"kind": "pattern", "base": "{{local_app_data}}", "segments": ["Google", "Chrome", "User Data", "*", "Network"]},
     "item_type": "any", "min_age_hours": 0, "keep_newest": 0, "in_use": {"mode": "none", "processes": []}},
    {"target_id": "electron-app-cache#0", "group_id": "electron-app-cache", "rule_id": "electron-app-cache", "level": "recommended", "category": "app_leftover",
     "match": {"kind": "pattern", "base": "{{local_app_data}}", "segments": ["*", "Cache"]},
     "item_type": "dir", "min_age_hours": 1, "keep_newest": 0, "in_use": {"mode": "none", "processes": []}},
    {"target_id": "installer-unpack-temp#0", "group_id": "installer-unpack-temp", "rule_id": "installer-unpack-temp", "level": "recommended", "category": "app_leftover",
     "match": {"kind": "pattern", "base": "{{system_temp}}", "segments": ["vscode-stable-*"]},
     "item_type": "dir", "min_age_hours": 24, "keep_newest": 0, "in_use": {"mode": "none", "processes": []}},
    {"target_id": "npm-cache#0", "group_id": "npm-cache", "rule_id": "npm-cache", "level": "recommended", "category": "dev_cache",
     "match": {"kind": "pattern", "base": "{{local_app_data}}", "segments": ["npm-cache"]},
     "item_type": "dir", "min_age_hours": 1, "keep_newest": 0, "in_use": {"mode": "none", "processes": []}},
    {"target_id": "crash-dumps#0", "group_id": "crash-dumps", "rule_id": "crash-dumps", "level": "recommended", "category": "crash_log",
     "match": {"kind": "pattern", "base": "{{local_app_data}}", "segments": ["CrashDumps", "*.dmp"]},
     "item_type": "file", "min_age_hours": 24, "keep_newest": 0, "in_use": {"mode": "none", "processes": []}},
    {"target_id": "system-temp-old#0", "group_id": "system-temp-old", "rule_id": "system-temp-old", "level": "recommended", "category": "system_temp",
     "match": {"kind": "discovery", "root": "{{system_temp}}"},
     "item_type": "any", "min_age_hours": 168, "keep_newest": 0, "in_use": {"mode": "none", "processes": []}},
    {"target_id": "user-temp-old#0", "group_id": "user-temp-old", "rule_id": "user-temp-old", "level": "recommended", "category": "system_temp",
     "match": {"kind": "discovery", "root": "{{user_temp}}"},
     "item_type": "any", "min_age_hours": 168, "keep_newest": 0, "in_use": {"mode": "none", "processes": []}}
  ],
  "hard_guards": ["{{user_profile}}", "{{local_app_data}}", "{{roaming_app_data}}", "{{user_temp}}", "{{system_temp}}", "{{windows}}", "{{program_data}}", "{{downloads}}", "{{system_drive}}"]
}
